// quests.ron
// Grief pair: Mournhollow (village) and Ashmourn (cult).
// Kinds used: Fetch and Tag only (Timing needs a relative deadline).
// An NPC shows its first quest in this file that isn't Done, so order
// per NPC is the order here.
// Tag quests complete when a rite's selected reagents carry the tag
// (the hidden holy/profane disposal weight does not count). The quest
// does NOT check burial vs burning, so offer text must not promise one.
// Rep goes to the NPC's own faction. Rewards stay small: repeatable
// quests are for filling time, not for moving the rep pace. New fetch
// quests pay 0 rep and reward items instead; new tag quests pay 0.5.
// turn_in_text is spoken by the NPC when the quest is turned in.

[
        // ---------- Elsbet (hub) ----------
    // Intro chain: one-time (cooldown 0), one lesson each.
    (
        id: "elsbet_first_light",
        npc_id: "elsbet",
        kind: Fetch(item_id: "salt", count: 1),
        offer_text: "Ah, the new keeper. Bless you for coming. Start small: the morgue keeps its salt on a shelf by the door. Fetch me one measure, and I'll know you can find your way around.",
        turn_in_text: "Good. You take what's needed and no more. Here, a candle for your trouble. You'll want it soon.",
        reward_rep: 0.0,
        reward_stipend: 3.0,
        reward_item: Some(("candle", 1)),
        cooldown_days: 0,
    ),
    (
        id: "elsbet_first_rite",
        npc_id: "elsbet",
        kind: Tag(tag: "holy"),
        offer_text: "The dead come every morning. Look them over in the morgue first, then send them off with something blessed. That candle will do. Choose what goes in before you lay them to rest.",
        turn_in_text: "Thank you. They noticed. It gets easier, or at least quieter.",
        reward_rep: 1.0,
        reward_stipend: 5.0,
        reward_item: None,
        cooldown_days: 0,
    ),
    (
        id: "elsbet_workyard",
        npc_id: "elsbet",
        kind: Fetch(item_id: "grave_dirt", count: 2),
        offer_text: "The workyard lies west of the crossroads. It keeps grave dirt and iron nails. Bring me two handfuls of dirt, so you learn the way.",
        turn_in_text: "Good. Dirt for the graves, iron for the lids. Everything has its place here.",
        reward_rep: 0.0,
        reward_stipend: 4.0,
        reward_item: Some(("salt", 1)),
        cooldown_days: 0,
    ),
    (
        id: "elsbet_keep_them",
        npc_id: "elsbet",
        kind: Tag(tag: "preserved"),
        offer_text: "Salt keeps what rot would take. Put a measure in the rite itself, once you've finished examining them. Salt added before the examination is spent on the keeping, and won't count.",
        turn_in_text: "Kept, and kept well. The dead appreciate a little patience.",
        reward_rep: 0.5,
        reward_stipend: 5.0,
        reward_item: None,
        cooldown_days: 0,
    ),
    (
        id: "elsbet_other_side",
        npc_id: "elsbet",
        kind: Tag(tag: "profane"),
        offer_text: "Every choice you make here leans one way or the other. Work something profane into a rite, grave dirt will do, and watch what it does to your standing.",
        turn_in_text: "You saw it, didn't you? Every rite tugs one way or the other. The trick is knowing which.",
        reward_rep: 0.0,
        reward_stipend: 5.0,
        reward_item: Some(("candle", 1)),
        cooldown_days: 0,
    ),

    // Repeatable filler (unchanged, flowers moved to the end)
    (
        id: "elsbet_candles",
        npc_id: "elsbet",
        kind: Fetch(item_id: "candle", count: 2),
        offer_text: "Could you spare two candles? The chapel never seems to have enough.",
        turn_in_text: "Thank you. I'll see they're lit.",
        reward_rep: 0.5,
        reward_stipend: 4.0,
        reward_item: None,
        cooldown_days: 3,
    ),
    (
        id: "elsbet_salt",
        npc_id: "elsbet",
        kind: Fetch(item_id: "salt", count: 3),
        offer_text: "The chapel stores spoil in the damp. Three measures of salt would see us through the month.",
        turn_in_text: "That will keep the winter stores sound.",
        reward_rep: 0.0,
        reward_stipend: 4.0,
        reward_item: Some(("candle", 1)),
        cooldown_days: 4,
    ),
    (
        id: "elsbet_holy_rite",
        npc_id: "elsbet",
        kind: Tag(tag: "holy"),
        offer_text: "Send someone off with something blessed in the rite. People notice when it's done properly.",
        turn_in_text: "Thank you. They noticed.",
        reward_rep: 0.5,
        reward_stipend: 4.0,
        reward_item: None,
        cooldown_days: 5,
    ),
    (
        id: "elsbet_flowers",
        npc_id: "elsbet",
        kind: Fetch(item_id: "mourning_wreath", count: 2),
        offer_text: "Could you bring me a pair of bell flowers? The chapel table looks bare without them.",
        turn_in_text: "Bless you for these.",
        reward_rep: 1.0,
        reward_stipend: 3.0,
        reward_item: None,
        cooldown_days: 3,
    ),

    // ---------- Old Wren (hub, Mournhollow) ----------
    (
        id: "wren_candles",
        npc_id: "wren",
        kind: Fetch(item_id: "candle", count: 2),
        offer_text: "I run short of candles by midwinter. Could you spare a couple?",
        turn_in_text: "That'll see me through.",
        reward_rep: 0.5,
        reward_stipend: 4.0,
        reward_item: None,
        cooldown_days: 4,
    ),
    (
        id: "wren_grief_rite",
        npc_id: "wren",
        kind: Tag(tag: "grief"),
        offer_text: "Next time you lay someone down, put a bell flower in with the rest. Grief should be named at the end.",
        turn_in_text: "Good. It was named.",
        reward_rep: 1.0,
        reward_stipend: 5.0,
        reward_item: None,
        cooldown_days: 5,
    ),
    (
        id: "wren_salt",
        npc_id: "wren",
        kind: Fetch(item_id: "salt", count: 2),
        offer_text: "A line of salt on the doorstep keeps the damp out. Old habit. Could you spare two measures?",
        turn_in_text: "There. Keeps the wet out, and the worse things.",
        reward_rep: 0.0,
        reward_stipend: 3.0,
        reward_item: Some(("candle", 1)),
        cooldown_days: 4,
    ),

    // ---------- Tamsin (Mournhollow) ----------
    (
        id: "tamsin_wreath",
        npc_id: "tamsin",
        kind: Fetch(item_id: "mourning_wreath", count: 1),
        offer_text: "Aunt Wren pretends she doesn't like the bell flowers. Could you bring me one? I'll leave it where she'll find it.",
        turn_in_text: "She'll pretend she didn't notice. She will.",
        reward_rep: 0.5,
        reward_stipend: 3.0,
        reward_item: Some(("salt", 2)),
        cooldown_days: 3,
    ),
    (
        id: "tamsin_nails",
        npc_id: "tamsin",
        kind: Fetch(item_id: "iron_nail", count: 2),
        offer_text: "Aunt Wren's gate is held shut with string and stubbornness. Two nails and I'll fix it before she notices.",
        turn_in_text: "She'll blame the wind. Let her.",
        reward_rep: 0.0,
        reward_stipend: 3.0,
        reward_item: Some(("salt", 1)),
        cooldown_days: 3,
    ),

    // ---------- Odo (Mournhollow) ----------
    (
        id: "odo_nails",
        npc_id: "odo",
        kind: Fetch(item_id: "iron_nail", count: 3),
        offer_text: "Coffin lids don't nail themselves. Spare me three?",
        turn_in_text: "Good iron. Ta.",
        reward_rep: 0.5,
        reward_stipend: 4.0,
        reward_item: Some(("grave_dirt", 2)),
        cooldown_days: 3,
    ),
    (
        id: "odo_holy_rite",
        npc_id: "odo",
        kind: Tag(tag: "holy"),
        offer_text: "Work something holy into a rite. A candle will do. Humor me.",
        turn_in_text: "There. Lit the way down.",
        reward_rep: 1.0,
        reward_stipend: 5.0,
        reward_item: None,
        cooldown_days: 4,
    ),
    (
        id: "odo_dirt",
        npc_id: "odo",
        kind: Fetch(item_id: "grave_dirt", count: 3),
        offer_text: "The backfill's gone to clay. Three handfuls of good grave dirt and I'll stop swearing at it.",
        turn_in_text: "Better. Almost pleasant to dig.",
        reward_rep: 0.0,
        reward_stipend: 4.0,
        reward_item: Some(("iron_nail", 1)),
        cooldown_days: 3,
    ),

    // ---------- Elder Maren (Mournhollow) ----------
    (
        id: "maren_preserved",
        npc_id: "maren",
        kind: Tag(tag: "preserved"),
        offer_text: "Perform a rite with salt in it, so the Hall can say the dead were kept.",
        turn_in_text: "The Hall will remember it.",
        reward_rep: 1.0,
        reward_stipend: 5.0,
        reward_item: None,
        cooldown_days: 5,
    ),
    (
        id: "maren_candles",
        npc_id: "maren",
        kind: Fetch(item_id: "candle", count: 3),
        offer_text: "The Hall keeps a light for every keeper. Three candles, if you can.",
        turn_in_text: "Thank you. They'll burn well.",
        reward_rep: 0.5,
        reward_stipend: 6.0,
        reward_item: None,
        cooldown_days: 4,
    ),
    (
        id: "maren_wreath",
        npc_id: "maren",
        kind: Fetch(item_id: "mourning_wreath", count: 2),
        offer_text: "The Hall keeps a flower on every sill through the dark months. Two bell flowers, if you can.",
        turn_in_text: "They'll last the week. Thank you.",
        reward_rep: 0.5,
        reward_stipend: 6.0,
        reward_item: Some(("candle", 2)),
        cooldown_days: 5,
    ),

    // ---------- Sexton Halbrecht (Mournhollow) ----------
    (
        id: "halbrecht_wreath",
        npc_id: "halbrecht",
        kind: Fetch(item_id: "mourning_wreath", count: 1),
        offer_text: "I leave a flower on the chapel step for every soul I ring for. Bring me one, would you?",
        turn_in_text: "One more for the step.",
        reward_rep: 0.0,
        reward_stipend: 3.0,
        reward_item: Some(("candle", 1)),
        cooldown_days: 3,
    ),
    (
        id: "halbrecht_nails",
        npc_id: "halbrecht",
        kind: Fetch(item_id: "iron_nail", count: 2),
        offer_text: "The bell yoke's loose again. Two nails, and it'll ring true.",
        turn_in_text: "Hear that? True as a plumb line.",
        reward_rep: 0.0,
        reward_stipend: 4.0,
        reward_item: Some(("salt", 2)),
        cooldown_days: 3,
    ),
    (
        id: "halbrecht_bound_rite",
        npc_id: "halbrecht",
        kind: Tag(tag: "bound"),
        offer_text: "Work something bound into a rite - iron, or grave dirt. A bell needs something to hold the dead by while it rings.",
        turn_in_text: "Held fast. Good.",
        reward_rep: 0.5,
        reward_stipend: 5.0,
        reward_item: None,
        cooldown_days: 5,
    ),

    // ---------- Warden Dorn (hub, Ashmourn) ----------
    (
        id: "dorn_ash",
        npc_id: "dorn",
        kind: Fetch(item_id: "widows_ash", count: 2),
        offer_text: "Bring me two ember-ash blooms. I'll scatter them from the north rise.",
        turn_in_text: "They'll carry well on this wind.",
        reward_rep: 1.0,
        reward_stipend: 3.0,
        reward_item: None,
        cooldown_days: 3,
    ),
    (
        id: "dorn_dirt",
        npc_id: "dorn",
        kind: Fetch(item_id: "grave_dirt", count: 2),
        offer_text: "The old fires need something to bank them down. Two handfuls of grave dirt, if you have it.",
        turn_in_text: "That'll bank them nicely.",
        reward_rep: 0.5,
        reward_stipend: 4.0,
        reward_item: None,
        cooldown_days: 4,
    ),
    (
        id: "dorn_profane_rite",
        npc_id: "dorn",
        kind: Tag(tag: "profane"),
        offer_text: "Work something profane into a rite. The pyre drinks what the grave won't.",
        turn_in_text: "It drank deep.",
        reward_rep: 0.5,
        reward_stipend: 5.0,
        reward_item: None,
        cooldown_days: 5,
    ),
    (
        id: "dorn_nails",
        npc_id: "dorn",
        kind: Fetch(item_id: "iron_nail", count: 2),
        offer_text: "Grate bars warp in the heat. Two nails to pin the new ones.",
        turn_in_text: "That'll hold until the next big burn.",
        reward_rep: 0.0,
        reward_stipend: 4.0,
        reward_item: Some(("grave_dirt", 1)),
        cooldown_days: 3,
    ),

    // ---------- Isk the Pyretender (Ashmourn) ----------
    (
        id: "isk_burn_rite",
        npc_id: "isk",
        kind: Tag(tag: "profane"),
        offer_text: "Put something profane in the rite - grave dirt will do. The fire should have something to hold.",
        turn_in_text: "It held. Good.",
        reward_rep: 1.0,
        reward_stipend: 5.0,
        reward_item: None,
        cooldown_days: 5,
    ),
    (
        id: "isk_nails",
        npc_id: "isk",
        kind: Fetch(item_id: "iron_nail", count: 2),
        offer_text: "Pyre frames hold with iron. Two nails would do.",
        turn_in_text: "That'll hold the frame.",
        reward_rep: 0.5,
        reward_stipend: 4.0,
        reward_item: None,
        cooldown_days: 3,
    ),
    (
        id: "isk_ash",
        npc_id: "isk",
        kind: Fetch(item_id: "widows_ash", count: 1),
        offer_text: "Fresh kindling remembers what it burned before. One ember-ash bloom, if you have it.",
        turn_in_text: "It'll catch easily.",
        reward_rep: 0.0,
        reward_stipend: 3.0,
        reward_item: Some(("grave_dirt", 2)),
        cooldown_days: 3,
    ),
    (
        id: "isk_bound_rite",
        npc_id: "isk",
        kind: Tag(tag: "bound"),
        offer_text: "Iron holds when the rest of us can't. Work something bound into a rite for me.",
        turn_in_text: "Held. Good.",
        reward_rep: 0.5,
        reward_stipend: 5.0,
        reward_item: None,
        cooldown_days: 5,
    ),

    // ---------- Sister Veda (Ashmourn) ----------
    (
        id: "veda_grief_rite",
        npc_id: "veda",
        kind: Tag(tag: "grief"),
        offer_text: "Put something grieving in a rite - an ember-ash bloom, if you have one - and let it go.",
        turn_in_text: "It's lighter now. You can tell.",
        reward_rep: 1.0,
        reward_stipend: 5.0,
        reward_item: None,
        cooldown_days: 5,
    ),
    (
        id: "veda_salt",
        npc_id: "veda",
        kind: Fetch(item_id: "salt", count: 3),
        offer_text: "Ash keeps better than salt, but we still run short. Three measures, if you can.",
        turn_in_text: "Thank you. We'll make use of it.",
        reward_rep: 0.5,
        reward_stipend: 3.0,
        reward_item: Some(("grave_dirt", 1)),
        cooldown_days: 3,
    ),
    (
        id: "veda_candles",
        npc_id: "veda",
        kind: Fetch(item_id: "candle", count: 2),
        offer_text: "We light a candle before every burning. It's only polite. Two, if you can spare them.",
        turn_in_text: "They'll burn well. Thank you.",
        reward_rep: 0.0,
        reward_stipend: 3.0,
        reward_item: Some(("widows_ash", 1)),
        cooldown_days: 4,
    ),
    (
        id: "veda_dirt",
        npc_id: "veda",
        kind: Fetch(item_id: "grave_dirt", count: 3),
        offer_text: "We bank the cold embers in grave dirt so nothing wakes by accident. Three handfuls?",
        turn_in_text: "Nothing will wake tonight.",
        reward_rep: 0.0,
        reward_stipend: 3.0,
        reward_item: Some(("salt", 2)),
        cooldown_days: 4,
    ),
]