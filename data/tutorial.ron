[
    (
        id: "tut_welcome",
        trigger: "game_start",
        text: "WASD to move, E to pick up reagents in front of you. The dead don't wait - the Village and the Cult are both watching, and neither agrees on what's right.",
    ),
    (
        id: "tut_pickup",
        trigger: "first_pickup",
        text: "Reagents shape the rite. Open your inventory with I, or click a slot in the bar below, to pick up to 4 for the next rite.",
    ),
    (
        id: "tut_burial",
        trigger: "first_burial",
        text: "Every disposal shifts reputation - burial leans Village, burning leans Cult. There's no rite that pleases everyone.",
    ),
    (
