(stipend:34.508587,reputation:{"cult":-2.0,"village":2.0},day_index:23,time_of_day:0.5902805,player_pos:(239.18813,-20.304485),player_inventory:{"grave_dirt":37,"salt":28,"iron_nail":30,"candle":27},zone_stock:{"incinerator":{},"keeper_shack":{},"workyard":{"iron_nail":4,"grave_dirt":5},"hopeforsworn":{},"ashmourn":{},"penncross":{},"mournhollow":{},"guiltpyre":{},"heartforge":{},"cellar":{},"mournhollow_grounds":{"mourning_wreath":4},"burial_site":{},"heartwarden":{},"hopewell":{},"morgue":{"salt":5,"candle":4}},fired_beats:[],fired_milestones:[],memory_fragments:[],keeper_number:1,tenure_start_day:0,cellar_records:[(name:"Adda Wren",years:"Day 1 - Day 340",epitaph:"Kept the ledgers straight. Buried holy, mostly. The Village remembers her kindly enough.",sacrificed_to:"unknown",village:"unknown"),(name:"Osric Vane",years:"Day 341 - Day 512",epitaph:"Favored the old ways - dirt and iron, more often than not. The Cult still speaks his name at the fire.",sacrificed_to:"unknown",village:"unknown"),(name:"Mirel Ashgrove",years:"Day 513 - Day 809",epitaph:"Balanced both sides as long as she could. Neither faction claims her, and neither forgets her.",sacrificed_to:"unknown",village:"unknown"),(name:"Tobin Colwick",years:"Day 810 - Day 1024",epitaph:"Short tenure. No record of why it ended. The ground took him same as anyone.",sacrificed_to:"unknown",village:"unknown"),(name:"Hollis Deighan",years:"Day 1025 - Day 1310",epitaph:"Came before the current keeper. Nothing else is written here yet.",sacrificed_to:"unknown",village:"unknown")],discovered_zones:["discover_mournhollow"],last_tended:{"workyard":23,"cellar":23,"morgue":23},fired_tutorial:["tut_pickup","tut_disposal_choice","tut_burial","tut_welcome","tut_reputation_conflict","tut_reagent_toggle","tut_village_travel"],sacrifice_available:false,pending_fragment:None,pending_sacrifice_faction:None,pending_village:None,next_corpse_id:7,missed_days_this_tenure:2,current_map:None,village_seeds:{"mournhollow":3617532846115